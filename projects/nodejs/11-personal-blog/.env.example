# 服务器配置
NODE_ENV=development
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123456
DB_NAME=blog_db

# JWT密钥（至少32位随机字符串）
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_123456
JWT_EXPIRES_IN=7d

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS配置
CORS_ORIGIN=http://localhost:3000,http://localhost:5500

# 加密轮数
BCRYPT_ROUNDS=10
