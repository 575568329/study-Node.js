# 项目特定：构建产物与上传目录
# 用全局规则（无前导斜杠 = 匹配任意层级的同名目录），避免 projects/**/x/ 只匹配目录、
# 不向下传播到文件的问题（曾导致 uploads 下的测试图被跟踪）
dist/
build/
uploads/
career/resume-web/tsconfig.tsbuildinfo

# Claude Code配置
# 本地设置（每台机器各自一份，不入库）
.claude/settings.local.json
# 备份文件
.claude/settings.backup.json
# CCode 工具运行时配置（本地）
.ccode/

# VSCode其他配置
.history/

# 可选：不提交会话笔记（如果包含敏感信息）
# sessions/
chroma/
gemini-interactions/.gemini-cookies.txt
gemini-interactions/.gemini-at-token.txt

# Gemini Web Chat 敏感数据
tools/gemini/.gemini-cookies.txt
tools/gemini/.gemini-at-token.txt
tools/gemini/conversations/
tools/gemini/test-*.png
tools/gemini/screenshot-*.png

# Obsidian 工作区状态（频繁变动，不入库）
knowledge/.obsidian/workspace.json
